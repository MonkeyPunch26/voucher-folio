<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_voucher" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.voucher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting string="Clave para pagos sin folio"
                         help="Permite validar un pago con tarjeta sin folio de voucher (p. ej. si la máquina se trabó). Se marca el método en Configuración > Métodos de pago > Exigir folio de voucher.">
                    <field name="pos_voucher_override_pin" password="True"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
